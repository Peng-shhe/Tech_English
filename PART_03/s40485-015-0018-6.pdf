   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Implications of various phosphoenolpyruvate-carbohydrate phosphotransferase system mutations on glycerol utilization and poly(3-hydroxybutyrate) accumulation in Ralstonia eutropha H16</rdf:li>
